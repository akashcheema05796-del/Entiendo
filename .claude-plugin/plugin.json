{
  "name": "entiendo",
  "description": "Entiendo control plane for AI-built software: the entiendo MCP server (steer/edit/eval through units), the entiendo-operator skill, and the enforce_claims boundary hook.",
  "version": "0.2.0",
  "author": {
    "name": "Entiendo"
  },
  "mcpServers": {
    "entiendo": {
      "command": "ent",
      "args": [
        "mcp",
        "--root",
        "."
      ]
    }
  },
  "skills": [
    "./.claude/skills/entiendo-operator",
    "./.claude/skills/entiendo-retrofit"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/enforce_claims.py\""
          }
        ]
      }
    ]
  }
}
