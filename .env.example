# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Server-side key used by the LangGraph nodes (llm_factory.ts)
GEMINI_API_KEY="your_gemini_api_key_here"

# Client-side key exposed to Vite / the browser (must be prefixed VITE_)
# Used by EntendoCanvas.tsx for the inline repo-structure summary
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# ─── Server ───────────────────────────────────────────────────────────────────
# Set to "production" to serve from /dist instead of running Vite middleware
NODE_ENV="development"

# Port to listen on (Railway sets this automatically, leave unset for local dev)
# PORT=3000

# Optional: Qdrant vector store URL (falls back to in-memory if not set)
# QDRANT_URL="http://localhost:6333"

# ─── Vite (dev only) ──────────────────────────────────────────────────────────
# Set to "true" to disable Hot Module Replacement
DISABLE_HMR="false"
