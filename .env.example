# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LLM Routing
PRIMARY_PROVIDER="gemini" # local | gemini | anthropic
COMPLEX_TASK_PROVIDER="gemini"

# Vector Store (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="codebase_index"

# Security
ALLOW_CLOUD_CODE_UPLOAD=false

# App Configuration
APP_URL="MY_APP_URL"
